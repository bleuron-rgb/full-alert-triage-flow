{
  "name": "sentry-alert-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-04-01",
  "observability": { "enabled": true }
  // Secrets, set with `wrangler secret put <NAME>`:
  //   SENTRY_CLIENT_SECRET  Client Secret of the Sentry internal integration
  //   ROUTINE_FIRE_URL      https://api.anthropic.com/v1/claude_code/routines/<trig_id>/fire
  //   ROUTINE_FIRE_TOKEN    Bearer token generated for the routine's API trigger
}
