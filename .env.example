# Copy to .env and fill in. The DSN is under Sentry > Project Settings > Client Keys (DSN).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
PORT=3000

# Only set these where the service should accept Sentry alerts and start triage runs:
# production, not staging. Without SENTRY_CLIENT_SECRET the webhook returns 404.
SENTRY_CLIENT_SECRET=
ROUTINE_FIRE_URL=
ROUTINE_FIRE_TOKEN=
